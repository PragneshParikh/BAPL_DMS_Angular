diff -ruN src/scss/_bgauss-autodash.scss work/scss/_bgauss-autodash.scss
--- src/scss/_bgauss-autodash.scss	1970-01-01 00:00:00.000000000 +0000
+++ work/scss/_bgauss-autodash.scss	2026-10-27 04:09:20.022263591 +0000
@@ -0,0 +1,703 @@
+//
+// _bgauss-autodash.scss
+// BGAUSS B2C DMS - "AutoDash" look & feel layer for the Velzon Angular theme.
+// Imported LAST in app.scss. To revert the look, comment out that one import line.
+//
+// Selector strategy: `html[data-theme]` (0,1,1) beats Velzon's `[data-theme="default"]` (0,1,0),
+// so every token below wins whichever data-theme / data-sidebar / data-topbar the layout sets.
+//
+
+// ---------------------------------------------------------------------------
+// 1. Design tokens
+// ---------------------------------------------------------------------------
+$ad-navy:          #0f172a;   // sidebar
+$ad-navy-2:        #1e293b;
+$ad-ink:           #0f172a;   // headings
+$ad-text:          #334155;   // body text
+$ad-muted:         #64748b;
+$ad-subtle:        #94a3b8;
+$ad-line:          #e2e8f0;
+$ad-line-soft:     #f1f5f9;
+$ad-surface:       #ffffff;
+$ad-canvas:        #f1f5f9;
+$ad-primary:       #6366f1;
+$ad-primary-2:     #8b5cf6;
+$ad-radius-card:   1rem;      // 16px
+$ad-radius-ctrl:   .625rem;   // 10px
+$ad-radius-tile:   .75rem;    // 12px
+$ad-shadow-card:   0 1px 3px rgba(15, 23, 42, .06), 0 1px 2px rgba(15, 23, 42, .04);
+$ad-shadow-hover:  0 8px 24px rgba(15, 23, 42, .08);
+$ad-ring:          0 0 0 .2rem rgba(99, 102, 241, .15);
+
+html[data-theme] {
+    --#{$prefix}font-family-primary:           'Inter', 'hkgrotesk', sans-serif;
+    --#{$prefix}font-family-secondary:         'Inter', 'Poppins', sans-serif;
+    --#{$prefix}headings-font-family:          'Inter', sans-serif;
+    --#{$prefix}vertical-menu-item-font-family:     'Inter', sans-serif;
+    --#{$prefix}vertical-menu-sub-item-font-family: 'Inter', sans-serif;
+    --#{$prefix}vertical-menu-item-font-size:       0.9375rem;
+    --#{$prefix}vertical-menu-sub-item-font-size:   0.875rem;
+
+    // Chart palette (use in ApexCharts / Chart.js options - see README)
+    --ad-chart-1: #5b8def;
+    --ad-chart-2: #34d399;
+    --ad-chart-3: #fbbf24;
+    --ad-chart-4: #a78bfa;
+    --ad-chart-5: #f472b6;
+    --ad-chart-6: #2dd4bf;
+
+    // Cards
+    --#{$prefix}card-border-width-custom:      1px;
+    --#{$prefix}card-shadow:                   #{$ad-shadow-card};
+
+    // Page title: no white strip, AutoDash-style heading
+    --#{$prefix}page-title-box-shadow:         none;
+    --#{$prefix}page-title-border:             transparent;
+
+    // Footer
+    --#{$prefix}footer-bg:                     #{$ad-surface};
+    --#{$prefix}footer-color:                  #{$ad-muted};
+}
+
+// Sidebar: always dark navy (matches AutoDash), whatever data-sidebar is set to.
+html[data-theme][data-sidebar],
+html[data-theme] {
+    --#{$prefix}vertical-menu-bg:                   #{$ad-navy};
+    --#{$prefix}vertical-menu-border:               #{$ad-navy};
+    --#{$prefix}vertical-menu-item-color:           #cbd5e1;
+    --#{$prefix}vertical-menu-item-bg:              rgba(255, 255, 255, .06);
+    --#{$prefix}vertical-menu-item-hover-color:     #ffffff;
+    --#{$prefix}vertical-menu-item-active-color:    #ffffff;
+    --#{$prefix}vertical-menu-item-active-bg:       rgba(255, 255, 255, .08);
+    --#{$prefix}vertical-menu-sub-item-color:       #94a3b8;
+    --#{$prefix}vertical-menu-sub-item-hover-color: #ffffff;
+    --#{$prefix}vertical-menu-sub-item-active-color:#ffffff;
+    --#{$prefix}vertical-menu-title-color:          #64748b;
+    --#{$prefix}twocolumn-menu-iconview-bg:         #0b1222;
+    --#{$prefix}vertical-menu-box-shadow:           none;
+    --#{$prefix}vertical-menu-dropdown-box-shadow:  0 10px 30px rgba(2, 6, 23, .35);
+    --#{$prefix}sidebar-user-bg:                    rgba(255, 255, 255, .06);
+    --#{$prefix}sidebar-user-name-text:             #ffffff;
+    --#{$prefix}sidebar-user-name-sub-text:         #94a3b8;
+}
+
+// Topbar: always white / light (matches AutoDash)
+html[data-theme][data-topbar],
+html[data-theme] {
+    --#{$prefix}header-bg:              #{$ad-surface};
+    --#{$prefix}header-border:          #{$ad-line};
+    --#{$prefix}header-item-color:      #{$ad-ink};
+    --#{$prefix}header-item-bg:         #{$ad-line-soft};
+    --#{$prefix}header-item-sub-color:  #{$ad-muted};
+    --#{$prefix}topbar-search-bg:       #{$ad-line-soft};
+    --#{$prefix}topbar-user-bg:         transparent;
+    --#{$prefix}topbar-search-color:    #{$ad-text};
+}
+
+// ---------------------------------------------------------------------------
+// 2. Base
+// ---------------------------------------------------------------------------
+body {
+    font-family: 'Inter', sans-serif;
+    color: $ad-text;
+    -webkit-font-smoothing: antialiased;
+    -moz-osx-font-smoothing: grayscale;
+}
+
+h1, h2, h3, h4, h5, h6,
+.h1, .h2, .h3, .h4, .h5, .h6 {
+    color: $ad-ink;
+    letter-spacing: -.01em;
+}
+
+a { color: $ad-primary; }
+a:hover { color: darken($ad-primary, 8%); }
+
+.text-muted { color: $ad-muted !important; }
+
+// ---------------------------------------------------------------------------
+// 3. Sidebar (vertical / semibox)
+// ---------------------------------------------------------------------------
+:is([data-layout="vertical"], [data-layout="semibox"]) {
+
+    .navbar-menu {
+        border-right: 0;
+
+        .navbar-brand-box {
+            height: $header-height;
+            display: flex;
+            align-items: center;
+            padding: 0 1.5rem;
+            border-bottom: 1px solid rgba(255, 255, 255, .06);
+            text-align: left;
+
+            .logo-dark  { display: none !important; }
+            .logo-light { display: inline-block !important; }
+        }
+
+        .menu-title {
+            color: var(--#{$prefix}vertical-menu-title-color);
+            font-size: .75rem;
+            font-weight: 600;
+            letter-spacing: .12em;
+
+            span { padding: 1.5rem 1.75rem .5rem; }
+        }
+
+        .navbar-nav .nav-link {
+            font-weight: 500;
+
+            i, svg { color: #94a3b8; transition: color .15s ease; }
+
+            &:hover, &.active, &[aria-expanded="true"] {
+                i, svg { color: #ffffff; }
+            }
+        }
+
+        // Sub-menu
+        .navbar-nav .nav-sm .nav-link {
+            font-weight: 400;
+
+            &:before { background-color: #475569; }
+
+            &.active {
+                color: #ffffff;
+                font-weight: 500;
+                &:before { background-color: $ad-primary; opacity: 1; width: 6px; height: 6px; border-radius: 50%; top: 15px; }
+            }
+        }
+
+        // Scrollbar inside sidebar
+        .simplebar-scrollbar:before { background: rgba(255, 255, 255, .25); }
+    }
+
+    // Rounded "pill" menu items - only when the sidebar is expanded (lg / md)
+    &:not([data-sidebar-size="sm"]):not([data-sidebar-size="sm-hover"]):not([data-sidebar-size="sm-hover-active"]) {
+        .navbar-menu .navbar-nav > .nav-item > .nav-link {
+            margin: 2px .75rem;
+            padding: .7rem 1rem;
+            border-radius: $ad-radius-ctrl;
+            transition: background-color .15s ease, color .15s ease;
+
+            &:hover { background-color: rgba(255, 255, 255, .05); }
+
+            &.active,
+            &[aria-expanded="true"] {
+                background-color: var(--#{$prefix}vertical-menu-item-active-bg);
+                color: #ffffff;
+            }
+
+            &[data-bs-toggle="collapse"]:after { right: 1.75rem; font-size: 1.15rem; }
+        }
+
+        .navbar-menu .navbar-nav .nav-sm { padding-left: 2.6rem; }
+    }
+}
+
+// Logo text helper (optional): <span class="ad-brand">BGauss <b>DMS</b></span>
+.ad-brand {
+    font-size: 1.375rem;
+    font-weight: 700;
+    color: #ffffff;
+    letter-spacing: -.02em;
+    b { color: #60a5fa; font-weight: 700; }
+}
+.ad-brand-mark {
+    width: 40px; height: 40px;
+    border-radius: $ad-radius-tile;
+    display: inline-flex; align-items: center; justify-content: center;
+    background: linear-gradient(135deg, $ad-primary, $ad-primary-2);
+    color: #ffffff; font-size: 1.25rem;
+    margin-right: .75rem;
+}
+
+// ---------------------------------------------------------------------------
+// 4. Topbar
+// ---------------------------------------------------------------------------
+#page-topbar {
+    border-bottom: 1px solid $ad-line;
+    box-shadow: none;
+
+    &.topbar-shadow { box-shadow: 0 1px 0 $ad-line; }
+}
+
+.navbar-header {
+    padding-left: 1.5rem;
+    padding-right: 1.5rem;
+
+    .vertical-menu-btn {
+        width: 42px;
+        height: 42px;
+        padding: 0 !important;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+        background-color: $ad-line-soft;
+        border-radius: $ad-radius-ctrl;
+        margin-right: .75rem;
+        &:hover { background-color: $ad-line; }
+    }
+
+    .btn-topbar {
+        border-radius: $ad-radius-ctrl !important;
+        color: #475569;
+        font-size: 1.25rem;
+        &:hover, &:focus, &.active { background-color: $ad-line-soft; color: $ad-ink; }
+    }
+
+    .user-name-text { font-weight: 600; color: $ad-ink; font-size: .9375rem; }
+    .user-name-sub-text { color: $ad-muted; font-size: .8125rem; }
+}
+
+.app-search {
+    padding: calc(#{$header-height - 44px} * 0.5) 0;
+
+    .form-control {
+        height: 44px;
+        min-width: 360px;
+        border: 1px solid $ad-line !important;
+        border-radius: $ad-radius-ctrl;
+        padding-left: 44px;
+        background-color: $ad-line-soft;
+        font-size: .9375rem;
+        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
+
+        &:focus { background-color: #ffffff; border-color: $ad-primary !important; box-shadow: $ad-ring; }
+    }
+
+    span.search-widget-icon { line-height: 44px; left: 15px; color: $ad-subtle; }
+
+    @media (max-width: 1199.98px) { .form-control { min-width: 260px; } }
+}
+
+.topbar-user {
+    background-color: transparent !important;
+    .btn { padding-left: .75rem !important; padding-right: .5rem !important; }
+}
+
+.header-profile-user {
+    width: 42px;
+    height: 42px;
+    border-radius: $ad-radius-ctrl !important;
+    object-fit: cover;
+}
+
+// Initials avatar for the topbar user (optional): <span class="ad-avatar">AD</span>
+.ad-avatar {
+    width: 42px; height: 42px;
+    border-radius: $ad-radius-ctrl;
+    display: inline-flex; align-items: center; justify-content: center;
+    background: linear-gradient(135deg, $ad-primary, $ad-primary-2);
+    color: #ffffff; font-weight: 700; font-size: .9375rem;
+}
+
+.topbar-badge {
+    font-size: 10px;
+    padding: .25em .45em;
+    border: 2px solid #ffffff;
+}
+
+// ---------------------------------------------------------------------------
+// 5. Page content & page title
+// ---------------------------------------------------------------------------
+.page-content {
+    padding-top: calc(#{$header-height} + 1.75rem);
+    padding-left: 1.75rem;
+    padding-right: 1.75rem;
+
+    @media (max-width: 767.98px) { padding-left: .75rem; padding-right: .75rem; }
+}
+
+// Velzon breadcrumb component -> large title with breadcrumb underneath (AutoDash style)
+html[data-layout] .page-title-box {
+    background-color: transparent !important;
+    box-shadow: none;
+    border: 0;
+    padding: 0;
+    margin: 0 0 1.75rem 0;
+    flex-direction: column;
+    align-items: flex-start !important;
+    justify-content: flex-start !important;
+
+    h4 {
+        font-size: 1.75rem !important;
+        font-weight: 700;
+        text-transform: none;
+        letter-spacing: -.02em;
+        color: $ad-ink;
+        margin-bottom: .35rem !important;
+    }
+
+    .page-title-right { margin-left: 0 !important; }
+}
+
+.breadcrumb {
+    font-size: .9375rem;
+
+    .breadcrumb-item {
+        > a { color: $ad-primary; font-weight: 500; }
+        &.active { color: $ad-subtle; }
+
+        + .breadcrumb-item::before {
+            content: "/";
+            font-family: inherit;
+            font-size: .9375rem;
+            line-height: inherit;
+            color: $ad-muted;
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// 6. Cards & KPI tiles
+// ---------------------------------------------------------------------------
+.card {
+    border: 1px solid rgba(226, 232, 240, .7);
+    border-radius: $ad-radius-card;
+    box-shadow: $ad-shadow-card;
+    margin-bottom: 1.5rem;
+
+    > .card-header:first-child { border-radius: $ad-radius-card $ad-radius-card 0 0; }
+    > .card-footer:last-child  { border-radius: 0 0 $ad-radius-card $ad-radius-card; }
+}
+
+.card-header {
+    background-color: transparent;
+    border-bottom: 1px solid $ad-line-soft;
+    padding: 1.25rem 1.5rem;
+}
+
+.card-title,
+.card-header .card-title {
+    font-size: 1.125rem;
+    font-weight: 600;
+    color: $ad-ink;
+    text-transform: none;
+}
+
+.card-body { padding: 1.5rem; }
+
+.card-footer {
+    background-color: transparent;
+    border-top: 1px solid $ad-line-soft;
+    padding: 1rem 1.5rem;
+}
+
+.card-animate {
+    transition: transform .2s ease, box-shadow .2s ease;
+    &:hover { transform: translateY(-2px); box-shadow: $ad-shadow-hover; }
+}
+
+// Velzon widget icons -> soft rounded tiles
+.avatar-title.rounded,
+.avatar-title.rounded-2,
+.avatar-title.rounded-3 { border-radius: $ad-radius-tile !important; }
+
+// KPI tile (AutoDash "Total Listed / Avg Days to Sell ..." cards)
+//  <div class="card kpi-card">
+//    <div class="card-body d-flex justify-content-between align-items-start">
+//      <div><p class="kpi-label">Total Retail</p><h3 class="kpi-value">12,847</h3></div>
+//      <span class="kpi-icon kpi-primary"><i class="ri-motorbike-line"></i></span>
+//    </div>
+//  </div>
+.kpi-card .card-body { padding: 1.75rem; }
+.kpi-label { color: $ad-muted; font-size: .9375rem; font-weight: 500; margin-bottom: .5rem; }
+.kpi-value { color: $ad-ink; font-size: 2.125rem; font-weight: 700; letter-spacing: -.02em; line-height: 1.1; margin: 0; }
+.kpi-trend { font-size: .8125rem; font-weight: 600; margin-top: .5rem;
+    &.up   { color: #059669; }
+    &.down { color: #dc2626; }
+}
+.kpi-icon {
+    width: 60px; height: 60px;
+    border-radius: $ad-radius-tile;
+    display: inline-flex; align-items: center; justify-content: center;
+    font-size: 1.75rem; flex-shrink: 0;
+}
+.kpi-primary { background: #eef2ff; color: #4f46e5; }
+.kpi-blue    { background: #eff6ff; color: #2563eb; }
+.kpi-success { background: #ecfdf5; color: #059669; }
+.kpi-warning { background: #fffbeb; color: #d97706; }
+.kpi-purple  { background: #f5f3ff; color: #7c3aed; }
+.kpi-danger  { background: #fef2f2; color: #dc2626; }
+.kpi-info    { background: #f0f9ff; color: #0284c7; }
+
+// ---------------------------------------------------------------------------
+// 7. Buttons
+// ---------------------------------------------------------------------------
+.btn {
+    border-radius: $ad-radius-ctrl;
+    font-weight: 500;
+    padding: .55rem 1.1rem;
+    transition: background-color .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
+
+    &:focus-visible { box-shadow: $ad-ring; }
+}
+.btn-sm { padding: .375rem .75rem; border-radius: .5rem; }
+.btn-lg { padding: .75rem 1.4rem; border-radius: .75rem; }
+
+.btn-primary {
+    --#{$prefix}btn-bg: #{$ad-primary};
+    --#{$prefix}btn-border-color: #{$ad-primary};
+    --#{$prefix}btn-hover-bg: #4f46e5;
+    --#{$prefix}btn-hover-border-color: #4f46e5;
+    --#{$prefix}btn-active-bg: #4338ca;
+    --#{$prefix}btn-active-border-color: #4338ca;
+}
+
+// Outline buttons: 1px border, white fill (AutoDash "Export Report")
+[class*="btn-outline-"] { background-color: #ffffff; }
+.btn-outline-success {
+    --#{$prefix}btn-color: #059669;
+    --#{$prefix}btn-border-color: #059669;
+    --#{$prefix}btn-hover-bg: #ecfdf5;
+    --#{$prefix}btn-hover-color: #047857;
+    --#{$prefix}btn-hover-border-color: #047857;
+    --#{$prefix}btn-active-bg: #d1fae5;
+    --#{$prefix}btn-active-color: #047857;
+}
+.btn-outline-primary {
+    --#{$prefix}btn-hover-bg: #eef2ff;
+    --#{$prefix}btn-hover-color: #4f46e5;
+    --#{$prefix}btn-active-bg: #e0e7ff;
+    --#{$prefix}btn-active-color: #4338ca;
+}
+.btn-light {
+    --#{$prefix}btn-bg: #{$ad-line-soft};
+    --#{$prefix}btn-border-color: #{$ad-line-soft};
+    --#{$prefix}btn-color: #{$ad-text};
+    --#{$prefix}btn-hover-bg: #{$ad-line};
+    --#{$prefix}btn-hover-border-color: #{$ad-line};
+}
+
+// ---------------------------------------------------------------------------
+// 8. Forms (Bootstrap + ng-select + flatpickr inputs)
+// ---------------------------------------------------------------------------
+.form-control,
+.form-select {
+    border: 1px solid $ad-line;
+    border-radius: $ad-radius-ctrl;
+    background-color: #ffffff;
+    color: $ad-text;
+    padding: .6rem .9rem;
+    font-size: .9375rem;
+
+    &::placeholder { color: $ad-subtle; }
+
+    &:focus {
+        border-color: $ad-primary;
+        box-shadow: $ad-ring;
+    }
+
+    &:disabled, &[readonly] { background-color: $ad-line-soft; }
+}
+.form-control-sm, .form-select-sm { padding: .4rem .7rem; border-radius: .5rem; font-size: .8125rem; }
+
+.form-label { color: #475569; font-weight: 500; font-size: .875rem; margin-bottom: .4rem; }
+
+.input-group-text {
+    background-color: $ad-line-soft;
+    border-color: $ad-line;
+    color: $ad-muted;
+}
+
+.form-check-input {
+    border: 1px solid #cbd5e1;
+    &:checked { background-color: $ad-primary; border-color: $ad-primary; }
+    &:focus   { box-shadow: $ad-ring; border-color: $ad-primary; }
+}
+
+.ng-select {
+    .ng-select-container {
+        min-height: 42px;
+        border: 1px solid $ad-line;
+        border-radius: $ad-radius-ctrl;
+    }
+    &.ng-select-focused:not(.ng-select-opened) > .ng-select-container {
+        border-color: $ad-primary;
+        box-shadow: $ad-ring;
+    }
+    &.ng-select-opened > .ng-select-container { border-color: $ad-primary; }
+}
+.ng-dropdown-panel {
+    border: 1px solid $ad-line !important;
+    border-radius: $ad-radius-ctrl !important;
+    box-shadow: $ad-shadow-hover;
+    overflow: hidden;
+    .ng-dropdown-panel-items .ng-option.ng-option-marked { background-color: #eef2ff; color: #4f46e5; }
+    .ng-dropdown-panel-items .ng-option.ng-option-selected { background-color: #e0e7ff; color: #4338ca; }
+}
+
+// ---------------------------------------------------------------------------
+// 9. Tables
+// ---------------------------------------------------------------------------
+.table {
+    --#{$prefix}table-border-color: #{$ad-line-soft};
+    --#{$prefix}table-hover-bg: #{$ad-line-soft};
+    color: $ad-text;
+
+    > thead th,
+    > thead td {
+        background-color: #f8fafc;
+        color: $ad-muted;
+        font-size: .75rem;
+        font-weight: 600;
+        text-transform: uppercase;
+        letter-spacing: .05em;
+        border-bottom: 1px solid $ad-line;
+        padding-top: .85rem;
+        padding-bottom: .85rem;
+        white-space: nowrap;
+    }
+
+    > tbody td { vertical-align: middle; padding-top: .9rem; padding-bottom: .9rem; }
+}
+.table-light {
+    --#{$prefix}table-bg: #f8fafc;
+    --#{$prefix}table-color: #{$ad-muted};
+}
+.table-card { margin: -1.5rem; }
+.table-card .table > :not(caption) > * > *:first-child { padding-left: 1.5rem; }
+.table-card .table > :not(caption) > * > *:last-child  { padding-right: 1.5rem; }
+
+// ---------------------------------------------------------------------------
+// 10. Badges, nav, dropdown, modal, pagination, alerts
+// ---------------------------------------------------------------------------
+.badge {
+    font-weight: 600;
+    border-radius: .375rem;
+    padding: .4em .65em;
+    letter-spacing: .01em;
+}
+
+.nav-tabs {
+    border-bottom: 1px solid $ad-line;
+    .nav-link { color: $ad-muted; font-weight: 500; border: 0; border-bottom: 2px solid transparent; }
+    .nav-link.active { color: $ad-primary; border-bottom-color: $ad-primary; background: transparent; }
+}
+.nav-pills {
+    .nav-link { border-radius: $ad-radius-ctrl; color: $ad-muted; font-weight: 500; }
+    .nav-link.active, .show > .nav-link { background-color: $ad-primary; color: #ffffff; }
+}
+
+.dropdown-menu {
+    border: 1px solid $ad-line;
+    border-radius: .75rem;
+    box-shadow: $ad-shadow-hover;
+    padding: .5rem;
+
+    .dropdown-item {
+        border-radius: .5rem;
+        padding: .5rem .75rem;
+        color: $ad-text;
+        &:hover, &:focus { background-color: $ad-line-soft; color: $ad-ink; }
+        &.active, &:active { background-color: #eef2ff; color: #4f46e5; }
+    }
+}
+
+.modal-content {
+    border: 0;
+    border-radius: $ad-radius-card;
+    box-shadow: 0 24px 48px rgba(15, 23, 42, .18);
+}
+.modal-header { border-bottom: 1px solid $ad-line-soft; padding: 1.25rem 1.5rem; }
+.modal-title  { font-weight: 600; color: $ad-ink; }
+.modal-body   { padding: 1.5rem; }
+.modal-footer { border-top: 1px solid $ad-line-soft; padding: 1rem 1.5rem; }
+
+.pagination {
+    gap: .35rem;
+    .page-link {
+        border-radius: .5rem !important;
+        border: 1px solid $ad-line;
+        color: $ad-text;
+        min-width: 36px;
+        text-align: center;
+        &:hover { background-color: $ad-line-soft; color: $ad-ink; }
+    }
+    .page-item.active .page-link { background-color: $ad-primary; border-color: $ad-primary; color: #ffffff; }
+}
+
+.alert { border-radius: .75rem; }
+
+.progress { border-radius: 999px; background-color: $ad-line-soft; }
+.progress-bar { border-radius: 999px; }
+
+// ---------------------------------------------------------------------------
+// 11. Footer, scrollbars, charts
+// ---------------------------------------------------------------------------
+.footer {
+    border-top: 1px solid $ad-line;
+    color: $ad-muted;
+}
+
+* {
+    scrollbar-width: thin;
+    scrollbar-color: #cbd5e1 transparent;
+}
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+
+.apexcharts-canvas,
+.apexcharts-canvas text,
+.apexcharts-legend-text,
+.apexcharts-tooltip { font-family: 'Inter', sans-serif !important; }
+.apexcharts-gridline,
+.apexcharts-grid line { stroke: $ad-line-soft; }
+.apexcharts-xaxis-label, .apexcharts-yaxis-label { fill: $ad-muted; }
+.apexcharts-legend-text { color: $ad-text !important; font-weight: 500 !important; }
+.apexcharts-tooltip.apexcharts-theme-light {
+    border: 1px solid $ad-line !important;
+    border-radius: .5rem;
+    box-shadow: $ad-shadow-hover !important;
+}
+
+// ---------------------------------------------------------------------------
+// 12. Dark mode (data-bs-theme="dark") - keep the same structure, darker surfaces
+// ---------------------------------------------------------------------------
+html[data-bs-theme="dark"] {
+    --#{$prefix}header-bg:              #111827;
+    --#{$prefix}header-border:          #1f2937;
+    --#{$prefix}header-item-color:      #e5e7eb;
+    --#{$prefix}header-item-bg:         #1f2937;
+    --#{$prefix}topbar-search-bg:       #1f2937;
+    --#{$prefix}topbar-search-color:    #e5e7eb;
+    --#{$prefix}vertical-menu-bg:       #0b1120;
+    --#{$prefix}vertical-menu-border:   #0b1120;
+    --#{$prefix}footer-bg:              #111827;
+
+    body, .table { color: #cbd5e1; }
+    h1, h2, h3, h4, h5, h6, .card-title, .kpi-value, .modal-title,
+    .page-title-box h4, .navbar-header .user-name-text { color: #f1f5f9; }
+
+    #page-topbar, .footer { border-color: #1f2937; }
+    .card { border-color: #1f2937; box-shadow: none; }
+    .card-header, .card-footer, .modal-header, .modal-footer { border-color: #1f2937; }
+
+    .form-control, .form-select, .ng-select .ng-select-container {
+        background-color: #0f172a; border-color: #1f2937; color: #e5e7eb;
+    }
+    .app-search .form-control { border-color: #1f2937 !important; background-color: #1f2937; }
+    .navbar-header .vertical-menu-btn,
+    .navbar-header .btn-topbar:hover { background-color: #1f2937; }
+    .navbar-header .btn-topbar { color: #cbd5e1; }
+
+    .table > thead th, .table-light { background-color: #0f172a; --#{$prefix}table-bg: #0f172a; color: #94a3b8; border-color: #1f2937; }
+    .table { --#{$prefix}table-border-color: #1f2937; --#{$prefix}table-hover-bg: #172033; }
+
+    .dropdown-menu { border-color: #1f2937; }
+    .dropdown-menu .dropdown-item { color: #cbd5e1; &:hover { background-color: #1f2937; color: #fff; } }
+    .pagination .page-link { border-color: #1f2937; color: #cbd5e1; background-color: transparent; }
+    [class*="btn-outline-"] { background-color: transparent; }
+
+    .kpi-primary { background: rgba(99, 102, 241, .15); color: #a5b4fc; }
+    .kpi-blue    { background: rgba(59, 130, 246, .15); color: #93c5fd; }
+    .kpi-success { background: rgba(16, 185, 129, .15); color: #6ee7b7; }
+    .kpi-warning { background: rgba(245, 158, 11, .15); color: #fcd34d; }
+    .kpi-purple  { background: rgba(139, 92, 246, .15); color: #c4b5fd; }
+    .kpi-danger  { background: rgba(239, 68, 68, .15);  color: #fca5a5; }
+    .kpi-info    { background: rgba(14, 165, 233, .15); color: #7dd3fc; }
+
+    .apexcharts-gridline, .apexcharts-grid line { stroke: #1f2937; }
+    ::-webkit-scrollbar-thumb { background: #334155; }
+}
